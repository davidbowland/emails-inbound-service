[
  {
    "text": "Please reply with \"NO\" to stop",
    "phrase": "reply with \"NO\"",
    "expected": true,
    "note": "straight double quotes in text and phrase"
  },
  {
    "text": "Please reply with \u201cNO\u201d to stop",
    "phrase": "reply with \"NO\"",
    "expected": true,
    "note": "curly double quotes in text"
  },
  {
    "text": "Please reply with 'NO' to stop",
    "phrase": "reply with \"NO\"",
    "expected": true,
    "note": "single quotes in text"
  },
  {
