  },
  {
    "text": "cafe\u0301 open",
    "phrase": "caf\u00e9",
    "expected": true,
    "note": "NFKC composes combining accents"
  },
  {
    "text": "Sch\u00f6n hier",
    "phrase": "sch\u00f6n",
    "expected": true,
    "note": "non-ASCII letters are word characters"
  },
  {
    "text": "Call +1 (555) 010-0000",
    "phrase": "555 010 0000",
    "expected": true,
    "note": "phone punctuation is a separator"
  },
  {
    "text": "anything at all",
    "phrase": "!!! ???",
    "expected": false,
    "note": "symbol-only phrase has no words and never matches"
  },
  {
    "text": "anything at all",
    "phrase": "",
    "expected": false,
    "note": "empty phrase never matches"
  },
  {
    "text": "",
    "phrase": "hello",
    "expected": false,
    "note": "empty text never matches"
  },
  {
    "text": "quick question for you",
    "phrase": "question quick",
    "expected": false,
    "note": "words must be in order"
  },
  {
    "text": "quick and question",
    "phrase": "quick question",
    "expected": false,
    "note": "words must be consecutive"
  },
  {
    "text": "(a+)+$ literal text",
    "phrase": "(a+)+$",
    "expected": true,
    "note": "regex metacharacters are literal separators"
  },
  {
    "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!",
    "phrase": "(a+)+$",
    "expected": false,
    "note": "metacharacter phrase does not behave as a regex"
  },
  {
    "text": "Grow your business with SEO",
    "phrase": "grow your business",
    "expected": true,
    "note": "multi-word phrase inside sentence"
  },
  {
    "text": "grow your\nbusiness",
    "phrase": "Grow Your Business",
    "expected": true,
    "note": "phrase spans a line break"
  }
]
